# Copy to .env and adjust (optional: docuscrypt runs with the defaults). Every variable the app
# reads is listed here and in the README. No secrets: the app stores nothing.

# --- App ---
# HTTP port inside the container; keep 8080 under Compose
PORT=8080

# --- Compose ---
# IMAGE=eacer/docuscrypt:v3.0   # pin a release; default eacer/docuscrypt:latest
# APP_BIND=127.0.0.1   # publish on loopback only when a proxy fronts the app
# APP_PORT=8080
